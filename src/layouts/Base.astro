---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Lo que marca el cajetín de la cabecera.
  sheetNow: string;
  sheetTotal: string;
}

const { lang, title, description, sheetNow, sheetTotal } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} — Juan Diego Vargas` : t.metaTitle;
const pageDescription = description ?? t.metaDescription;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Marca que hay scripts: sin ella, todo el contenido se muestra en flujo normal.
      (function () {
        var mark = function () {
          document.documentElement.classList.add('js');
        };
        mark();
        document.addEventListener('astro:after-swap', mark);
        // Si la escena no llega a arrancar (red, bloqueador), se vuelve al flujo normal
        // para que ninguna hoja quede oculta.
        setTimeout(function () {
          var root = document.documentElement;
          if (document.querySelector('[data-scene]') && root.dataset.scene !== 'ready') {
            root.classList.remove('js');
          }
        }, 4000);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} sheetNow={sheetNow} sheetTotal={sheetTotal} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
