---
import { ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import { links } from '../i18n/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const l = links[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__in mono">
    <p>© {year} · {t.footerBuilt}</p>
    <p class="site-footer__links">
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗<span class="visually-hidden"> ({l.newTab})</span></a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="visually-hidden"> ({l.newTab})</span></a>
    </p>
  </div>
</footer>
