---
import { ui, type Lang } from '../i18n/ui';
import { homePath, switchLangPath } from '../lib/projects';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  // Lo que marca el cajetín: la hoja de esta página y el total.
  sheetNow: string;
  sheetTotal: string;
}
const { lang, sheetNow, sheetTotal } = Astro.props;
const t = ui[lang];
const home = homePath(lang);
const other = switchLangPath(Astro.url.pathname, lang);
---

<header class="site-header paper">
  <div class="wrap site-header__in">
    <a class="brand" href={home} aria-label={site.name}>{site.shortName}</a>
    <nav class="nav mono" aria-label={t.navLabel}>
      <a href={`${home}#about`}>{t.navAbout}</a>
      <a href={`${home}#work`}>{t.navWork}</a>
      <a href={`${home}#services`}>{t.navServices}</a>
      <a href={`${home}#contact`}>{t.navContact}</a>
    </nav>
    <div class="lang mono site-header__lang" role="group" aria-label={t.langLabel}>
      <svg class="lang__globe" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.400 5.800 12 3z"></path>
      </svg>
      {
        (['es', 'en'] as const).map((code) =>
          code === lang ? (
            <span class="lang__opt is-on" aria-current="true">
              {code.toUpperCase()}
            </span>
          ) : (
            <a class="lang__opt" href={other} hreflang={code} lang={code} aria-label={t.otherLangLabel}>
              {code.toUpperCase()}
            </a>
          ),
        )
      }
    </div>
    <dl class="titleblock">
      <div>
        <dt>{t.tbProject}</dt>
        <dd>{t.tbName}</dd>
      </div>
      <div>
        <dt>{t.tbSheet}</dt>
        <dd><span data-sheet-now>{sheetNow}</span> / {sheetTotal}</dd>
      </div>
      <div>
        <dt>{t.tbRev}</dt>
        <dd>{new Date().getFullYear()}</dd>
      </div>
    </dl>
  </div>
</header>
