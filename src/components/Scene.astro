---
// La escena: las hojas que siguen a la portada, el riel con sus números y el
// personaje. Sin scripts es una lista de secciones en flujo normal. En
// pantallas amplias se vuelve una escena fija: cada tramo de scroll pasa a la
// hoja siguiente y el personaje cruza al lado contrario y toma su rol.
import Figure from './Figure.astro';
import { ui, type Lang } from '../i18n/ui';
import { sheets, scenePoses, type SheetId } from '../data/sheets';

interface Props {
  lang: Lang;
  // Rótulo de cada hoja, para el riel.
  labels: Record<SheetId, string>;
}
const { lang, labels } = Astro.props;
const t = ui[lang];
const first = sheets[0];
const cast = t.cast[first.pose as keyof typeof t.cast];
---

<div class="scene" data-scene style={`--sheets:${sheets.length}`}>
  <div class="scene__pin paper" data-pin>
    <nav class="rail" aria-label={t.railLabel} data-cue={t.railCue}>
      {
        sheets.map((s, i) => (
          <a
            href={`#${s.id}`}
            data-rail
            aria-label={`${t.sheetWord} ${s.number} · ${labels[s.id]}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            {s.number}
          </a>
        ))
      }
    </nav>
    <div class="scene__body">
      <slot />
      <aside
        class="actor"
        aria-hidden="true"
        data-actor
        data-side={first.side}
        data-pose={first.pose}
        data-cast={JSON.stringify(t.cast)}
      >
        <p class="balloon" data-balloon>{cast.say}</p>
        <div class="actor__figs">
          {scenePoses.map((pose) => <Figure pose={pose} clip class={pose === first.pose ? 'is-on' : undefined} />)}
        </div>
        <p class="mono actor__role">
          <span data-role-name>{cast.role}</span>
          <span>{t.figWord} <span data-fig-number>{first.number}</span></span>
        </p>
      </aside>
    </div>
  </div>
</div>

<script>
  import { ALT_ROLE, ROLE_EVENT, SHEET_ENTER } from '../lib/events';

  // Cuándo la escena queda fija. La misma condición está en home.css.
  const PINNED = '(min-width: 1000px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)';

  type Cast = Record<string, { role: string; say: string }>;

  let stop: AbortController | undefined;

  function init() {
    stop?.abort();
    const scene = document.querySelector<HTMLElement>('[data-scene]');
    if (!scene) return;
    stop = new AbortController();
    const { signal } = stop;

    const pin = scene.querySelector<HTMLElement>('[data-pin]')!;
    const sheets = [...scene.querySelectorAll<HTMLElement>('[data-sheet]')];
    const dots = [...scene.querySelectorAll<HTMLElement>('[data-rail]')];
    const actor = scene.querySelector<HTMLElement>('[data-actor]')!;
    const actorFigs = [...actor.querySelectorAll<HTMLElement>('[data-fig]')];
    const balloon = actor.querySelector<HTMLElement>('[data-balloon]')!;
    const roleName = actor.querySelector<HTMLElement>('[data-role-name]')!;
    const figNumber = actor.querySelector<HTMLElement>('[data-fig-number]')!;
    const cast: Cast = JSON.parse(actor.dataset.cast!);
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const heroFig = hero?.querySelector<HTMLElement>('[data-fig]');
    const sheetNow = document.querySelector<HTMLElement>('[data-sheet-now]');

    const pinned = matchMedia(PINNED);
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const walkMs = parseFloat(getComputedStyle(actor).getPropertyValue('--walk-ms')) || 1000;

    // ---- Clips ----
    // Cada pose tiene un clip en bucle que se descarga al llegar a ella.
    // Safari no respeta la transparencia de este formato, así que ahí (y con
    // movimiento reducido) se queda la imagen fija.
    const noAlpha = /^((?!chrome|chromium|android).)*safari/i.test(navigator.userAgent);
    const canPlay = () => !still.matches && !noAlpha;
    // Apiladas, cada hoja trae su propia figura: su clip corre solo a la vista.
    const ownFigs = sheets.map((sheet) => sheet.querySelector<HTMLElement>('.sheet__fig [data-fig]'));

    for (const clip of document.querySelectorAll<HTMLVideoElement>('[data-fig] video')) {
      const fig = clip.parentElement!;
      const live = () => fig.classList.toggle('is-live', fig.dataset.clip === 'on');
      clip.addEventListener('playing', live, { signal });
      clip.addEventListener('error', () => fig.classList.remove('is-live'), { signal });
    }

    function setClip(fig: HTMLElement | null | undefined, on: boolean) {
      const clip = fig?.querySelector('video');
      if (!fig || !clip || (fig.dataset.clip === 'on') === on) return;
      fig.dataset.clip = on ? 'on' : 'off';
      if (on) {
        if (!clip.src) clip.src = clip.dataset.src!;
        clip.currentTime = 0;
        clip.play().catch(() => fig.classList.remove('is-live'));
      } else {
        clip.pause();
        fig.classList.remove('is-live');
      }
    }

    // ---- Personaje ----
    let step = -1; // hoja activa de la escena fija; -1: todavía ninguna
    let alt = false; // la demo de roles pidió la pose alterna
    let walkTimer = 0;

    function setPose(pose: string) {
      actor.dataset.pose = pose;
      for (const fig of actorFigs) {
        const on = fig.dataset.fig === pose;
        fig.classList.toggle('is-on', on);
        setClip(fig, on && pinned.matches && canPlay());
      }
    }

    // Llega a su sitio: toma la pose del rol y dice su frase.
    function arrive() {
      const sheet = sheets[Math.max(step, 0)];
      const pose = (alt && sheet.dataset.altPose) || sheet.dataset.pose!;
      actor.classList.remove('is-walking');
      setPose(pose);
      balloon.textContent = cast[pose].say;
      roleName.textContent = cast[pose].role;
      figNumber.textContent = sheet.dataset.number!;
    }

    // Lleva al personaje al lado que pide la hoja activa. Si cambia de lado,
    // cruza caminando; al cargar la página aparece ya en su sitio.
    function direct(walk: boolean) {
      const side = sheets[Math.max(step, 0)].dataset.side!;
      if (actor.dataset.side !== side) {
        if (walk) {
          actor.style.setProperty('--dir', side === 'right' ? '1' : '-1');
          actor.classList.add('is-walking');
          setPose('walk');
          actor.dataset.side = side;
          clearTimeout(walkTimer);
          walkTimer = window.setTimeout(arrive, walkMs);
          return;
        }
        actor.style.transition = 'none';
        actor.dataset.side = side;
        void actor.offsetWidth;
        actor.style.transition = '';
      }
      // Si ya va caminando hacia ese lado, toma la pose nueva al llegar.
      if (walk && actor.classList.contains('is-walking')) return;
      clearTimeout(walkTimer);
      arrive();
    }

    // ---- Hojas ----
    const seen = new Set<HTMLElement>();

    function enter(sheet: HTMLElement) {
      seen.add(sheet);
      sheet.classList.add('is-on');
      sheet.dispatchEvent(new CustomEvent(SHEET_ENTER, { bubbles: true }));
    }

    // Escena fija: muestra la hoja `i` y deja las demás fuera del teclado.
    function show(i: number, walk: boolean) {
      step = i;
      sheets.forEach((sheet, n) => {
        sheet.classList.toggle('is-past', n < i);
        sheet.inert = n !== i;
        if (n === i) enter(sheet);
        else sheet.classList.remove('is-on');
      });
      dots.forEach((dot, n) => {
        if (n === i) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      direct(walk);
    }

    let queued = false;
    let pinTop = 0; // dónde se pega la escena: justo bajo la cabecera
    const span = () => (scene.offsetHeight - pin.offsetHeight) / sheets.length;

    function update() {
      queued = false;
      if (signal.aborted) return;
      const top = scene.getBoundingClientRect().top;
      let current: HTMLElement | null | undefined = hero;

      if (pinned.matches) {
        const i = Math.min(sheets.length - 1, Math.max(0, Math.floor((pinTop - top) / span())));
        if (i !== step) show(i, step >= 0);
        if (top - pinTop < window.innerHeight / 2) current = sheets[i];
      } else {
        sheets.forEach((sheet, n) => {
          const y = sheet.getBoundingClientRect().top;
          if (y < window.innerHeight * 0.8 && !seen.has(sheet)) enter(sheet);
          if (y < window.innerHeight / 2) current = sheet;
          const box = ownFigs[n]?.getBoundingClientRect();
          setClip(ownFigs[n], canPlay() && !!box && box.bottom > 0 && box.top < window.innerHeight);
        });
      }

      // El cajetín de la cabecera dice en qué hoja va la lectura.
      if (sheetNow && current) sheetNow.textContent = current.dataset.number!;
      // El saludo de la portada solo se mueve mientras está a la vista.
      setClip(heroFig, canPlay() && (pinned.matches ? top > pinTop : hero!.getBoundingClientRect().bottom > 0));
    }

    function request() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }

    // Al entrar o salir de la escena fija se rehace el estado.
    function sync() {
      clearTimeout(walkTimer);
      step = -1;
      // Las hojas vuelven a contar como no vistas: cada modo decide cuáles activa.
      seen.clear();
      if (pinned.matches) {
        pinTop = parseFloat(getComputedStyle(pin).top) || 0;
        ownFigs.forEach((fig) => setClip(fig, false));
      } else {
        pinTop = 0;
        for (const sheet of sheets) {
          sheet.inert = false;
          sheet.classList.remove('is-past');
        }
        actorFigs.forEach((fig) => setClip(fig, false));
      }
      update();
    }

    // ---- Anclas ----
    // En la escena fija una hoja no tiene posición propia: se llega a ella
    // con el scroll que le corresponde.
    function jump(hash: string, focus: boolean) {
      const i = sheets.findIndex((sheet) => `#${sheet.id}` === hash);
      if (i < 0 || !pinned.matches) return false;
      const start = scene.getBoundingClientRect().top + window.scrollY - pinTop;
      window.scrollTo({ top: start + (i + 0.3) * span(), behavior: 'instant' });
      if (i !== step) show(i, step >= 0);
      if (focus) sheets[i].focus({ preventScroll: true });
      return true;
    }

    document.addEventListener(
      'click',
      (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href*="#"]') : null;
        if (!link || link.origin !== location.origin || link.pathname !== location.pathname) return;
        if (!jump(link.hash, true)) return;
        e.preventDefault();
        history.replaceState(history.state, '', link.hash);
      },
      { capture: true, signal },
    );
    window.addEventListener('hashchange', () => jump(location.hash, false), { signal });

    document.addEventListener(
      ROLE_EVENT,
      (e) => {
        alt = (e as CustomEvent<{ role: string }>).detail.role === ALT_ROLE;
        if (pinned.matches) direct(true);
      },
      { signal },
    );

    window.addEventListener('scroll', request, { passive: true, signal });
    window.addEventListener('resize', request, { signal });
    pinned.addEventListener('change', sync, { signal });
    still.addEventListener('change', request, { signal });
    signal.addEventListener('abort', () => clearTimeout(walkTimer));

    // La escena quedó lista: se confirma la marca que pone la cabecera del documento.
    document.documentElement.dataset.scene = 'ready';
    hero?.classList.add('is-on');
    sync();
    if (location.hash) requestAnimationFrame(() => jump(location.hash, false));
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.abort());
</script>
