---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Shot from './Shot.astro';
import { ui, type Lang } from '../i18n/ui';
import { links } from '../i18n/links';
import { getProjects, homePath, projectPath, slugOf, type Project } from '../lib/projects';
import { sheetById } from '../data/sheets';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = ui[lang];
const l = links[lang];
const d = project.data;
const { Content } = await render(project);

const all = await getProjects(lang);
const position = all.findIndex((p) => p.id === project.id);
const next = all.length > 1 ? all[(position + 1) % all.length] : undefined;
// En el cajetín, la página es un detalle de la hoja de proyectos.
const letter = sheetById('work').letter;
// Cada captura de la galería, con su versión más grande para el visor.
const gallery = await Promise.all(
  d.gallery.map(async (g) => ({ ...g, full: (await getImage({ src: g.src, width: g.src.width })).src })),
);
---

<Base
  lang={lang}
  title={d.title}
  description={d.tagline}
  sheetNow={`${letter}${position + 1}`}
  sheetTotal={`${letter}${all.length}`}
>
  <article class="project">
    <header class="wrap project__head">
      <a class="mono link-back" href={`${homePath(lang)}#work`}>← {t.backToWork}</a>
      <p class="meta">
        <span class:list={['tag', d.kind === 'source' && 'tag--on']}>
          {d.kind === 'source' ? t.kindSource : t.kindCase}
        </span>
        <span class="meta__status">{d.status}</span>
      </p>
      <h1 class="project__title">{d.title}</h1>
      <p class="project__tagline">{d.tagline}</p>
      <p class="links">
        {
          d.live && (
            <a class="btn btn--primary" href={d.live} target="_blank" rel="noopener noreferrer">
              {t.viewLive} ↗<span class="visually-hidden"> ({l.newTab})</span>
            </a>
          )
        }
        {
          d.repo && (
            <a class="btn" href={d.repo} target="_blank" rel="noopener noreferrer">
              {d.kind === 'source' ? t.viewCode : t.viewDocs} ↗<span class="visually-hidden"> ({l.newTab})</span>
            </a>
          )
        }
      </p>
    </header>

    {
      d.metrics.length > 0 && (
        <div class="wrap">
          <dl class="metrics">
            {d.metrics.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="wrap project__cover">
      <Shot image={d.cover} alt={d.title} title={d.title} url={d.live} sizes="94vw" zoom={`${l.zoom}: ${d.title}`} eager />
    </div>

    <div class="wrap project__body">
      <div class="prose">
        <Content />
      </div>
      <aside class="project__side">
        <h2 class="label">{t.projectStack}</h2>
        <ul class="chips">
          {d.stack.map((s) => <li>{s}</li>)}
        </ul>
        {
          d.year && (
            <>
              <h2 class="label">{t.projectYear}</h2>
              <p class="project__fact">{d.year}</p>
            </>
          )
        }
        {
          d.highlights.length > 0 && (
            <>
              <h2 class="label">{t.projectHighlights}</h2>
              <ul class="points">
                {d.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </>
          )
        }
      </aside>
    </div>

    {
      gallery.length > 0 && (
        <section class="wrap project__gallery">
          <h2 class="mono eyebrow">{t.projectGallery}</h2>
          <div class="gallery">
            {gallery.map((g) => (
              <figure class="gallery__item">
                <a href={g.full} data-zoom data-astro-reload data-caption={g.alt} aria-label={`${l.zoom}: ${g.alt}`}>
                  <Image
                    src={g.src}
                    alt=""
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 760px) 48vw, 92vw"
                    loading="lazy"
                  />
                </a>
                <figcaption>{g.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      next && (
        <a class="next" href={projectPath(lang, slugOf(next))}>
          <div class="wrap next__in">
            <span class="mono eyebrow">{t.nextProject}</span>
            <span class="next__title">{next.data.title} →</span>
          </div>
        </a>
      )
    }
  </article>
</Base>
