---
// Un proyecto como recorte pegado con cinta: su portada, el título y la marca
// de detalle. Todo el recorte enlaza a la página del proyecto.
import Shot from './Shot.astro';
import type { Lang } from '../i18n/ui';
import { projectPath, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
  detail: string;
}
const { project, lang, index, detail } = Astro.props;
const d = project.data;
// Cada recorte queda torcido hacia un lado distinto.
const tilts = [-2, 1.5, -1, 2];
---

<a class="cut pcut" href={projectPath(lang, slugOf(project))} style={`--r:${tilts[index % tilts.length]}deg`}>
  <Shot image={d.cover} alt="" title={d.title} bar={false} sizes="(min-width: 1000px) 30vw, 92vw" />
  <span class="pcut__cap">
    <span class="pcut__title">{d.title}</span>
    <span class="mono pcut__det">{detail}</span>
  </span>
  <span class="pcut__tagline">{d.tagline}</span>
</a>
