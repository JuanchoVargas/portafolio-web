---
// La portada (hoja 01) y, después, la escena con el resto de las hojas.
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import DemoLab from './DemoLab.vue';
import DemoRoles from './DemoRoles.vue';
import Figure from './Figure.astro';
import Floaters from './Floaters.astro';
import ProjectCard from './ProjectCard.astro';
import Scene from './Scene.astro';
import Sheet from './Sheet.astro';
import { ui, type Lang } from '../i18n/ui';
import { demoAgenda } from '../i18n/demo-agenda';
import { demoBot } from '../i18n/demo-bot';
import { demoQuote } from '../i18n/demo-quote';
import { getProjects, projectPath } from '../lib/projects';
import { sheetById, sheetTotal } from '../data/sheets';
import { site } from '../data/site';
import { stack, tech } from '../data/tech';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
// En desarrollo el formulario se muestra aunque no tenga a dónde enviar.
const showForm = Boolean(site.formEndpoint) || import.meta.env.DEV;

const labels = {
  work: t.workEyebrow,
  demo: t.demoEyebrow,
  security: t.securityEyebrow,
  services: t.servicesEyebrow,
  about: t.aboutEyebrow,
  contact: t.contactEyebrow,
};

// El tablero de proyectos: hasta tres recortes van en una fila; más, en dos.
const rows = projects.length > 3 ? 2 : 1;
const cols = Math.ceil(projects.length / rows);
const work = sheetById('work');
---

<Base lang={lang} sheetNow="01" sheetTotal={sheetTotal}>
  <section class="hero wrap" data-sheet data-hero data-number="01">
    <div class="hero__text">
      <p class="mono">{t.role}</p>
      <h1 class="hero__title">
        {t.heroA} <em>{t.heroEm}</em> {t.heroB}
      </h1>
      <p class="hero__lead">{t.heroLead}</p>
      <p class="hero__cta">
        <a class="btn btn--primary" href="#work">{t.ctaWork}</a>
        <a class="btn" href="#contact">{t.ctaContact}</a>
      </p>
      {site.available && <p class="stamp hero__stamp">{t.available}</p>}
      <div class="dim hero__dim" aria-hidden="true"><span>{t.heroDim}</span></div>
      <dl class="facts">
        {
          t.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="hero__stage">
      <Floaters set="hero" />
      <div class="hero__fig" aria-hidden="true">
        <p class="balloon">{t.sayHero}</p>
        <Figure pose="hello" clip eager />
        <div class="dim-v"><span>{t.heroHeight}</span></div>
      </div>
    </div>
    <aside class="legend" aria-label={t.legendTitle}>
      <p class="mono legend__title">{t.legendTitle}</p>
      <ul class="legend__list">
        <li><span class="legend__key" aria-hidden="true">↓</span>{t.legendScroll}</li>
        <li class="legend__pinned"><span class="legend__key legend__key--dot" aria-hidden="true">02</span>{t.legendRail}</li>
        <li><span class="legend__key legend__key--stamp" aria-hidden="true">demo</span>{t.legendDemo}</li>
        <li><span class="legend__key legend__key--hand" aria-hidden="true">↖</span>{t.legendNote}</li>
      </ul>
    </aside>
  </section>

  <Scene lang={lang} labels={labels}>
    <Sheet id="work" lang={lang} eyebrow={labels.work} title={t.workTitle} first>
      <div class="work">
        <div class="board" style={`--cols:${cols};--rows:${rows}`}>
          {
            projects.map((p, i) => (
              <ProjectCard project={p} lang={lang} index={i} detail={`${t.detWord} ${work.letter}${i + 1}`} />
            ))
          }
        </div>
        <p class="note hand">{t.noteWork}</p>
      </div>
    </Sheet>

    <Sheet id="demo" dark lang={lang} eyebrow={labels.demo} title={t.demoTitle}>
      <DemoLab
        client:visible
        label={t.demosLabel}
        bot={demoBot[lang]}
        agenda={demoAgenda[lang]}
        quote={demoQuote[lang]}
        pay={t.demoPay}
        thousands={t.thousands}
        stamp={t.fictional}
      />
    </Sheet>

    <Sheet id="security" dark lang={lang} eyebrow={labels.security} title={t.securityTitle}>
      <DemoRoles client:visible t={t.demoRoles} stamp={t.fictional} />
      <p class="note hand sheet__note">{t.noteRoles}</p>
    </Sheet>

    <Sheet id="services" lang={lang} eyebrow={labels.services} title={t.servicesTitle}>
      <div class="services">
        <ol class="list">
          {
            t.services.map((s, i) => (
              <li>
                <span class="list__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                  <p class="list__more">
                    <a class="link" href={s.to.startsWith('#') ? s.to : projectPath(lang, s.to)}>
                      {s.proof}
                    </a>
                    <a class="chip chip--go" href="#contact" data-quote={s.quote}>
                      {t.quoteCta}
                    </a>
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="cut review" style="--r:1.2deg">
          <p class="label">{t.reviewTitle}</p>
          <ul class="review__list">
            <li class="check">
              <span class="check__mark" aria-hidden="true">✓</span>
              <span>{t.reviewChecks[0]}</span>
              <span class="check__state">{t.reviewOk}</span>
            </li>
            <li class="check check--bad" data-review-bad>
              <span class="check__mark" aria-hidden="true">
                <span class="when-found">!</span><span class="when-fixed">✓</span>
              </span>
              <span>
                <span class="when-found">{t.reviewBad}</span>
                <span class="when-fixed">{t.reviewBadFixed}</span>
              </span>
              <span class="check__state">
                <span class="when-found">{t.reviewFound}</span>
                <span class="when-fixed">{t.reviewFixed}</span>
              </span>
            </li>
            <li class="check">
              <span class="check__mark" aria-hidden="true">✓</span>
              <span>{t.reviewChecks[1]}</span>
              <span class="check__state">{t.reviewOk}</span>
            </li>
          </ul>
        </div>
      </div>
    </Sheet>

    <Sheet id="about" lang={lang} eyebrow={labels.about} title={t.aboutTitle}>
      <div class="about">
        <div class="about__text">
          {t.about.map((p) => <p>{p}</p>)}
        </div>
        <div>
          <h3 class="label">{t.credentialsTitle}</h3>
          <ul class="creds">
            {
              t.credentials.map((c) => (
                <li>
                  <strong>{c.name}</strong>
                  <span>{c.detail}</span>
                </li>
              ))
            }
          </ul>
          <h3 class="label">{t.stackTitle}</h3>
          <ul class="chips">
            {
              stack.map((id) => (
                <li class="chips__tech" style={`--brand:#${tech[id].hex}`}>
                  <span class="chips__logo" aria-hidden="true">
                    {tech[id].icon ? (
                      <svg viewBox="0 0 24 24">
                        <path d={tech[id].icon} />
                      </svg>
                    ) : (
                      tech[id].text
                    )}
                  </span>
                  {tech[id].name}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Sheet>

    <Sheet id="contact" lang={lang} eyebrow={labels.contact} title={t.contactTitle}>
      <div class:list={['contact', showForm && 'contact--form']}>
        <div>
          <p class="contact__lead">{t.contactLead}</p>
          {
            showForm ? (
              <p class="links contact__alt">
                {t.contactAlt}
                <a class="link" href={site.linkedin} rel="noopener">LinkedIn</a>
                <a class="link" href={site.github} rel="noopener">GitHub</a>
              </p>
            ) : (
              <p class="links contact__cta">
                <a class="btn btn--primary" href={site.linkedin} rel="noopener">{t.contactLinkedin}</a>
                <a class="btn" href={site.github} rel="noopener">{t.contactGithub}</a>
              </p>
            )
          }
        </div>
        {showForm && <ContactForm lang={lang} />}
      </div>
    </Sheet>
  </Scene>
</Base>

<script>
  import { SHEET_ENTER } from '../lib/events';

  // El hallazgo de la revisión de ejemplo se arregla a la vista, poco después
  // de que entra su hoja.
  document.addEventListener(SHEET_ENTER, (e) => {
    const bad = (e.target as HTMLElement).querySelector('[data-review-bad]');
    if (!bad) return;
    const wait = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 2200;
    setTimeout(() => bad.classList.add('is-fixed'), wait);
  });

  // "Cotizar" deja escrito el inicio del mensaje en el formulario, salvo que
  // el visitante ya haya escrito el suyo.
  let filled = '';
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLElement>('[data-quote]');
    const box = document.querySelector<HTMLTextAreaElement>('#cf-message');
    if (!link || !box || (box.value && box.value !== filled)) return;
    box.value = filled = link.dataset.quote ?? '';
  });
</script>
