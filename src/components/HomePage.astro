---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import Shot from './Shot.astro';
import { ui, stackList, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
const lead = projects.find((p) => p.data.cover);
---

<Base lang={lang}>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <div class="hero__text">
      {
        site.available && (
          <p class="pill hero__pill">
            <span class="pill__dot" aria-hidden="true" />
            {t.available}
          </p>
        )
      }
      <p class="eyebrow hero__role">{t.role}</p>
      <h1 class="hero__title">
        <span class="line">{t.heroA}</span>
        <span class="line"><em>{t.heroEm}</em> {t.heroB}</span>
      </h1>
      <p class="hero__lead">{t.heroLead}</p>
      <p class="hero__cta">
        <a class="btn btn--primary" href="#work">{t.ctaWork}</a>
        <a class="btn" href="#contact">{t.ctaContact}</a>
      </p>
      </div>
      {
        lead && (
          <div class="hero__visual" aria-hidden="true">
            <div class="hero__tilt">
              <Shot image={lead.data.cover} alt="" title={lead.data.title} url={lead.data.live} eager />
            </div>
            {lead.data.metrics.slice(0, 2).map((m, i) => (
              <p class:list={['float', `float--${i}`]}>
                <strong>{m.value}</strong>
                <span>{m.label}</span>
              </p>
            ))}
          </div>
        )
      }
      <dl class="stats">
        {
          t.stats.map((s) => (
            <div class="stats__item">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...stackList, ...stackList].map((s) => <span>{s}</span>)}
    </div>
  </div>

  <section class="section" id="work">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="eyebrow">{t.workEyebrow}</p>
        <h2 class="section__title">{t.workTitle}</h2>
      </header>
      <div class="pcards">
        {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="services">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="eyebrow">{t.servicesEyebrow}</p>
        <h2 class="section__title">{t.servicesTitle}</h2>
      </header>
      <ol class="services">
        {
          t.services.map((s, i) => (
            <li class="service" data-reveal data-glow style={`--d:${i * 70}ms`}>
              <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about">
      <div data-reveal>
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2 class="section__title">{t.aboutTitle}</h2>
        {t.about.map((p) => <p class="about__p">{p}</p>)}
      </div>
      <aside class="about__side" data-reveal>
        <h3 class="about__h">{t.credentialsTitle}</h3>
        <ul class="creds">
          {
            t.credentials.map((c) => (
              <li>
                <strong>{c.name}</strong>
                <span>{c.detail}</span>
              </li>
            ))
          }
        </ul>
        <h3 class="about__h">{t.stackTitle}</h3>
        <ul class="chips">
          {stackList.map((s) => <li>{s}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap contact__in" data-reveal>
      <p class="eyebrow">{t.contactEyebrow}</p>
      <h2 class="contact__title">{t.contactTitle}</h2>
      <p class="contact__lead">{t.contactLead}</p>
      <p class="hero__cta">
        <a class="btn btn--primary" href={site.linkedin} rel="noopener">{t.contactLinkedin}</a>
        {site.email && <a class="btn" href={`mailto:${site.email}`}>{t.contactEmail}</a>}
        <a class="btn" href={site.github} rel="noopener">{t.contactGithub}</a>
      </p>
    </div>
  </section>
</Base>
