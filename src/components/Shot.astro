---
// Captura dentro de un marco de navegador. Sin imagen, dibuja una portada
// tipográfica. Con `bar={false}` va sin la barra del navegador.
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  title: string;
  url?: string;
  eager?: boolean;
  bar?: boolean;
  sizes?: string;
  // Con texto, la captura se puede abrir en el visor: es el nombre del enlace.
  zoom?: string;
}
const {
  image,
  alt,
  title,
  url,
  eager = false,
  bar = true,
  sizes = '(min-width: 960px) 56vw, 92vw',
  zoom,
} = Astro.props;
// La versión más grande de la captura, para el visor.
const full = image && zoom ? await getImage({ src: image, width: image.width }) : undefined;
const host = url ? new URL(url).host.replace(/^www\./, '') : title.toLowerCase().replace(/\s+/g, '-');
---

<figure class="shot">
  {
    bar && (
      <div class="shot__bar" aria-hidden="true">
        <span class="shot__dots">
          <i />
          <i />
          <i />
        </span>
        <span class="shot__url">{host}</span>
      </div>
    )
  }
  {
    image && full ? (
      <a href={full.src} data-zoom data-astro-reload data-caption={alt} aria-label={zoom}>
        <Image
          src={image}
          alt={alt}
          widths={[480, 800, 1200, 1600, 2400]}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          class="shot__img"
        />
      </a>
    ) : image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200, 1600, 2400]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        class="shot__img"
      />
    ) : (
      <div class="shot__blank" role="img" aria-label={alt}>
        <span class="shot__blank-title">{title}</span>
        <span class="shot__blank-line" />
        <span class="shot__blank-line shot__blank-line--b" />
        <span class="shot__blank-line shot__blank-line--c" />
      </div>
    )
  }
</figure>
